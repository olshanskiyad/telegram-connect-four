# Скопируйте в .env: cp .env.example .env
# Без заполнения работает гостевой режим: игра открывается в браузере без Telegram (см. README).

# --- Вход через Telegram (режим Mini App) ---
# Токен бота от @BotFather (команда /newbot). Храните как пароль
TELEGRAM_BOT_TOKEN=
# Имя бота без @. Нужно, чтобы кнопка «Скопировать ссылку» давала ссылку t.me/<бот>?startapp=room-КОД
TELEGRAM_BOT_USERNAME=
# Сколько секунд данные входа из Telegram (initData) считаются свежими. 0 - возраст не проверять
TELEGRAM_AUTH_MAX_AGE=86400

# --- Гостевой режим ---
# true или false. Если не задано: гости включены, пока TELEGRAM_BOT_TOKEN пуст, и выключены, когда токен задан
GUEST_MODE=
# Необязательно: секрет, которым подписываются гостевые токены. Если пусто, создаётся случайный и сохраняется в DATA_DIR/guest-secret
GUEST_SECRET=

# --- WebSocket-сервер (живые обновления комнаты) ---
# Адрес, по которому браузер подключается к нему. Локально: ws://localhost:3002.
# За reverse proxy с маршрутом /ws (deploy/nginx.example.conf) оставьте пустым: возьмётся адрес страницы + /ws.
# Если сервер не запущен, страница сама опрашивает комнату раз в 2,5 секунды
WS_PUBLIC_URL=ws://localhost:3002
# Порт и адрес, на которых слушает сам WebSocket-сервер (npm run ws). По умолчанию 127.0.0.1: только этот компьютер.
# Чтобы принимать подключения с других компьютеров, укажите 0.0.0.0 (в Docker это уже задано внутри контейнера)
WS_PORT=3002
WS_HOST=127.0.0.1

# --- Данные ---
# Папка с JSON-файлами игры (игроки, комнаты, рейтинг). Если пусто: ./data. В Docker задаётся в docker-compose.yml
DATA_DIR=
